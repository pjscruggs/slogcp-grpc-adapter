{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:semverAllWeekly",
    ":gomod",
    ":noUnscheduledUpdates",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/Chicago",
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "security:floor", "renovate:type-security-floor"],
    "vulnerabilityFixStrategy": "lowest",
    "automerge": false
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Do not automate the adapter's public Go compatibility floor",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "matchDepNames": ["go"],
      "matchFileNames": ["go.mod"],
      "enabled": false
    },
    {
      "description": "Do not update the CI tools module Go directive independently",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "matchDepNames": ["go"],
      "matchFileNames": [".github/tools/go.mod"],
      "enabled": false
    },
    {
      "description": "GitHub Actions updates stay separate from executable CI tools",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/**"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "groupName": "github actions",
      "labels": ["renovate:ci", "dependency-scope:ci"],
      "schedule": ["* 2 * * *"],
      "prPriority": 20
    },
    {
      "description": "Compiler-sensitive Go CI tools update together",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "github.com/golangci/golangci-lint/v2",
        "golang.org/x/tools",
        "golang.org/x/vuln"
      ],
      "matchFileNames": [".github/tools/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "groupName": "compiler-sensitive ci tools",
      "labels": ["renovate:ci", "dependency-scope:ci"],
      "schedule": ["* 2 * * *"],
      "prPriority": 25
    },
    {
      "description": "Auxiliary Go CI tools update separately",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "github.com/apache/skywalking-eyes"
      ],
      "matchFileNames": [".github/tools/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "groupName": "auxiliary ci tools",
      "labels": ["renovate:ci", "dependency-scope:ci"],
      "schedule": ["* 2 * * *"],
      "prPriority": 20
    },
    {
      "description": "Do not propose routine root go.mod dependency floor updates",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "matchDatasources": ["go"],
      "matchDepTypes": ["require"],
      "enabled": false
    },
    {
      "description": "Security floor updates await an explicit release decision",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "matchJsonata": ["$exists(vulnerabilityFixVersion)"],
      "enabled": true,
      "dependencyDashboardApproval": false,
      "automerge": false,
      "labels": ["security", "security:floor", "renovate:type-security-floor"]
    },
    {
      "description": "Keep the root go.mod toolchain directive on the latest released Go toolchain",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["toolchain"],
      "matchDepNames": ["go"],
      "matchFileNames": ["go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr",
      "groupName": "root go toolchain",
      "labels": ["renovate:toolchain", "dependency-scope:toolchain"],
      "prPriority": 15
    },
    {
      "description": "Keep checked-in example module go directives on the latest released Go version",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "matchDepNames": ["go"],
      "matchFileNames": [".examples/adapter/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "rangeStrategy": "bump",
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr",
      "groupName": "examples go directives",
      "labels": ["renovate:examples", "dependency-scope:examples", "renovate:go-version"],
      "prPriority": 6
    },
    {
      "description": "Routine latest-compatible updates for the checked-in adapter example",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchFileNames": [".examples/adapter/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "groupName": "examples module dependencies",
      "labels": ["renovate:examples", "dependency-scope:examples"],
      "schedule": ["* 3-6 * * *"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "prPriority": 5
    },
    {
      "description": "Do not update the local unpublished adapter requirement used by examples",
      "matchManagers": ["gomod"],
      "matchFileNames": [".examples/**"],
      "matchPackageNames": ["github.com/pjscruggs/slogcp-grpc-adapter"],
      "enabled": false
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10
}
